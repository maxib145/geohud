  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action button (Rechenweg steps, chapter done).",
      "html": "<button class=\"ds-btn\">Nächster Schritt</button>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-btn{font-family:var(--font);border:1px solid var(--line2);background:var(--hover);border-radius:7px;padding:8px 14px;font-size:13.5px;font-weight:500;color:var(--txt);cursor:pointer;transition:background-color .15s,border-color .15s,transform .08s} .ds-btn:hover{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 14%,var(--hover))} .ds-btn:active{transform:translateY(1px)} .ds-btn:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one emphasised action in a block.",
      "html": "<button class=\"ds-btn-pri\">Alle Schritte zeigen</button>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-btn-pri{font-family:var(--font);border:1px solid var(--acc);background:var(--acc);border-radius:7px;padding:8px 14px;font-size:13.5px;font-weight:600;color:#0F1117;cursor:pointer;transition:background-color .15s,transform .08s} .ds-btn-pri:hover{background:color-mix(in srgb,var(--acc) 86%,var(--txt))} .ds-btn-pri:active{transform:translateY(1px)} .ds-btn-pri:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-priority utility (theme toggle, Übersicht).",
      "html": "<button class=\"ds-ghost\">☀ Hell</button>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-ghost{font-family:var(--font);background:none;border:1px solid var(--line);border-radius:7px;padding:6px 10px;font-size:12px;color:var(--mut);cursor:pointer} .ds-ghost:hover{border-color:var(--line2);color:var(--txt)} .ds-ghost:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Subject list with status dots; active item tinted Lamp Blue.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-grp\">3. Semester</div><a class=\"on\"><span class=\"ds-dot full\"></span>Ausgleichsrechnung</a><a><span class=\"ds-dot\"></span>Angewandte Vermessung</a><a><span class=\"ds-dot legacy\"></span>Mathematik I</a></nav>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-nav{background:var(--bg2);padding:8px;width:260px;font-family:var(--font)} .ds-grp{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);padding:10px 10px 6px} .ds-nav a{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:7px;color:var(--txt2);font-size:14px;cursor:pointer} .ds-nav a:hover{background:var(--hover)} .ds-nav a.on{background:var(--acc-bg);color:var(--txt)} .ds-dot{width:6px;height:6px;border-radius:50%;background:var(--line2)} .ds-dot.full{background:var(--acc)} .ds-dot.legacy{background:transparent;border:1px solid var(--line2)}"
    },
    {
      "name": "Tabs",
      "kind": "nav",
      "refersTo": "",
      "description": "Segmented switch between Lernskript and Cheatsheet.",
      "html": "<div class=\"ds-tabs\"><button class=\"on\">Interaktives Lernskript</button><button>Klausur-Cheatsheet</button></div>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-tabs{display:inline-flex;gap:2px;background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:3px;font-family:var(--font)} .ds-tabs button{border:none;background:none;padding:6px 12px;border-radius:6px;font-size:13px;color:var(--mut);cursor:pointer;font-family:inherit} .ds-tabs button.on{background:var(--panel);color:var(--txt);box-shadow:0 0 0 1px var(--line2)} .ds-tabs button:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Subject Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Overview card per subject with progress bar.",
      "html": "<a class=\"ds-card\"><div class=\"t\">Ausgleichsrechnung</div><div class=\"m\">Modul 6018014</div><div class=\"bar\"><i style=\"width:40%\"></i></div></a>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-card{display:block;width:260px;border:1px solid var(--line2);border-radius:10px;padding:16px 18px;background:var(--hover);color:var(--txt);font-family:var(--font);cursor:pointer;transition:background-color .15s,border-color .15s,transform .08s} .ds-card:hover{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 8%,var(--hover))} .ds-card:active{transform:translateY(1px)} .ds-card .t{font-weight:600;font-size:15px} .ds-card .m{font-size:13px;color:var(--mut);margin-top:2px} .ds-card .bar{height:4px;background:var(--line);border-radius:4px;overflow:hidden;margin-top:12px} .ds-card .bar i{display:block;height:100%;background:var(--acc)}"
    },
    {
      "name": "Callout",
      "kind": "custom",
      "refersTo": "",
      "description": "Meaning-coded note: def (blue), trap (red), merke (green), ex (violet), info (amber).",
      "html": "<div class=\"ds-callout trap\"><div class=\"ct\">Klausurfalle</div><p>Vorzeichen der Verbesserung: v = L̂ − L, nicht umgekehrt.</p></div>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-callout{--c:#7AA2F7;--cb:rgba(122,162,247,.08);border:1px solid var(--line);border-left:3px solid var(--c);background:var(--cb);border-radius:8px;padding:12px 16px;max-width:520px;font-family:var(--font);color:var(--txt2)} .ds-callout.trap{--c:#F7768E;--cb:rgba(247,118,142,.08)} .ds-callout.merke{--c:#9ECE6A;--cb:rgba(158,206,106,.08)} .ds-callout.ex{--c:#BB9AF7;--cb:rgba(187,154,247,.08)} .ds-callout.info{--c:#E0AF68;--cb:rgba(224,175,104,.08)} .ds-callout .ct{font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--c);margin-bottom:4px} .ds-callout p{margin:6px 0}"
    },
    {
      "name": "Quiz Option",
      "kind": "custom",
      "refersTo": "quiz-option",
      "description": "Multiple-choice answer row with correct/wrong states.",
      "html": "<div class=\"ds-opts\"><button class=\"ds-opt\">Ω = vᵀPv wird minimal</button><button class=\"ds-opt ok\">Richtig markiert</button><button class=\"ds-opt bad\">Falsch markiert</button></div>",
      "css": ":host{--bg:#0F1117;--bg2:#13161E;--panel:#161A23;--hover:#1A1F2A;--line:#1E222D;--line2:#2A3040;--txt:#E6E8EE;--txt2:#B6BDCB;--mut:#8790A2;--dim:#5D6577;--acc:#7AA2F7;--acc-bg:rgba(122,162,247,.10);--ok:#9ECE6A;--bad:#F7768E;--code-bg:#0B0D12;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-opts{display:grid;gap:6px;max-width:480px;background:var(--panel);padding:14px;font-family:var(--font)} .ds-opt{text-align:left;border:1px solid var(--line2);background:var(--hover);border-radius:8px;padding:11px 14px;font-size:14.5px;color:var(--txt);cursor:pointer;font-family:inherit;transition:background-color .15s,border-color .15s,transform .08s} .ds-opt:hover{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,var(--hover))} .ds-opt:active{transform:translateY(1px)} .ds-opt:focus-visible{outline:2px solid var(--acc);outline-offset:1px} .ds-opt.ok{border-color:var(--ok);background:rgba(158,206,106,.08)} .ds-opt.bad{border-color:var(--bad);background:rgba(247,118,142,.08);color:var(--txt2)}"
